# Upstream Mem0 Platform credential. Not the leaderboard-facing key.
MEM0_API_KEY=
# Independent key used by leaderboard clients in X-Api-Key.
WRAPPER_API_KEY=
MEM0_BASE_URL=https://api.mem0.ai
# legacy: V1 add + V2 search; v3: V3 add + V3 search, with event polling.
MEM0_API_MODE=legacy
HOST=127.0.0.1
PORT=8894
REQUEST_DB_PATH=data/requests.sqlite3
UPSTREAM_TIMEOUT_SECONDS=60
ADD_WAIT_SECONDS=600
POLL_INTERVAL_SECONDS=1
MAX_ADD_CONCURRENCY=64
MAX_SEARCH_CONCURRENCY=64
